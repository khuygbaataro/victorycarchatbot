# ── Facebook ──────────────────────────────────────────────
# Page Access Token (Meta App → Messenger → Generate). pages_messaging эрхтэй.
PAGE_ACCESS_TOKEN=

# Webhook баталгаажуулах нууц үг — өөрөө зохионо.
# Meta dashboard-ийн Webhook тохиргоонд ЯГ ижлийг нь бичнэ.
VERIFY_TOKEN=victory_verify_change_me

# ── Өгөгдлийн сан (CarNumber1-ийн MongoDB Atlas) ───────────
# CarNumber1-ийн backend-ийн MONGODB_URI-тай ИЖИЛ утга.
MONGODB_URI=

# ── Сонголтууд ────────────────────────────────────────────
# CarNumber1 сайтын хаяг (carousel-д "Дэлгэрэнгүй" товч гаргана). Хоосон бол алгасна.
SITE_URL=

# Судалгааны скрипт (fetch:chats): сүүлийн хэдэн өдрийн чат татах вэ
DAYS=7
